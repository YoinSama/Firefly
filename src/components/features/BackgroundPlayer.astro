---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

export interface Props {
	playerUrl: string | string[];
	playerMode?: "order" | "random";
	playerVolume?: number;
	playerAutoPlay?: boolean | { desktop?: boolean; mobile?: boolean };
}

const {
	playerUrl,
	playerMode = "order",
	playerVolume = 0.1,
	playerAutoPlay = false,
} = Astro.props;

// 默认音量，0-1 之间；越界值在运行时会被夹紧
const defaultVolume = Math.min(1, Math.max(0, Number(playerVolume) || 0));

// 自动播放：支持布尔值，或分别设置桌面端/移动端
const autoPlayDesktop =
	typeof playerAutoPlay === "boolean"
		? playerAutoPlay
		: (playerAutoPlay?.desktop ?? false);
const autoPlayMobile =
	typeof playerAutoPlay === "boolean"
		? playerAutoPlay
		: (playerAutoPlay?.mobile ?? false);

const urls = Array.isArray(playerUrl) ? playerUrl : [playerUrl];
const hasMultiple = urls.length > 1;
const urlsJson = JSON.stringify(urls);

const tPrev = i18n(I18nKey.videoPrev);
const tNext = i18n(I18nKey.videoNext);
const tLoadError = i18n(I18nKey.videoLoadError);
---

{
	urls.length > 0 && (
		<div id="bg-player">
			<div
				id="bg-player-overlay"
				class="absolute inset-0 z-15 overflow-hidden pointer-events-none transition-opacity duration-500 ease-in-out opacity-0"
			>
				<video id="bg-player-video" preload="auto" playsinline class="size-full object-cover"></video>
			</div>

			<div id="bg-player-controls" class="absolute bottom-4 left-4 z-30 flex items-center gap-1.5 group">
				{hasMultiple && (
					<button
						id="bg-prev-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tPrev}
						aria-label={tPrev}
					>
						<Icon name="material-symbols:skip-previous-rounded" class="text-[1rem]" />
					</button>
				)}

				{hasMultiple && (
					<button
						id="bg-next-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tNext}
						aria-label={tNext}
					>
						<Icon name="material-symbols:skip-next-rounded" class="text-[1rem]" />
					</button>
				)}
			</div>

			<div
				id="bg-player-toast"
				class="fixed bottom-20 left-1/2 -translate-x-1/2 z-100 px-4 py-2 rounded-lg bg-black/70 text-white text-sm backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"
			>
				{tLoadError}
			</div>
		</div>
	)
}

<script is:inline define:vars={{ urls: urlsJson, playerMode, hasMultiple, defaultVolume, autoPlayDesktop, autoPlayMobile }}>
	(() => {
		var urlList = JSON.parse(urls);
		if (!urlList.length) return;
		var isMultiple = urlList.length > 1;

		var overlay = document.getElementById("bg-player-overlay");
		var video = document.getElementById("bg-player-video");
		var prevBtn = document.getElementById("bg-prev-btn");
		var nextBtn = document.getElementById("bg-next-btn");
		var toast = document.getElementById("bg-player-toast");

		if (!video) return;

		// 防止 is:inline 脚本重复注册监听器（Swup 导航会重新执行脚本）
		if (video.getAttribute("data-player-init")) return;
		video.setAttribute("data-player-init", "true");

		// 音量状态：优先读 localStorage，没有则用 config 里的 playerVolume
		var VOLUME_KEY = "bgPlayerVolume";
		var MUTED_KEY = "bgPlayerMuted";
		var DEFAULT_KEY = "bgPlayerVolumeDefault";
		function clampVolume(v) {
			v = Number(v);
			if (isNaN(v)) return defaultVolume;
			return Math.min(1, Math.max(0, v));
		}
		// 站长把 config 里的默认音量改了（如 0.1 -> 0.01）时，让访客跟随新默认值；
		// 访客自己拖过滑块的情况下也一并跟随，保证配置是唯一真相
		function syncDefaultVolume() {
			try {
				var storedDefault = localStorage.getItem(DEFAULT_KEY);
				if (storedDefault !== null && Math.abs(Number(storedDefault) - defaultVolume) > 1e-6) {
					localStorage.setItem(VOLUME_KEY, String(defaultVolume));
					localStorage.setItem(MUTED_KEY, "0");
				}
				localStorage.setItem(DEFAULT_KEY, String(defaultVolume));
			} catch (e) {}
		}
		function readVolume() {
			syncDefaultVolume();
			try {
				var s = localStorage.getItem(VOLUME_KEY);
				if (s !== null && s !== "") return clampVolume(s);
			} catch (e) {}
			return defaultVolume;
		}
		function readMuted() {
			try {
				return localStorage.getItem(MUTED_KEY) === "1";
			} catch (e) {}
			return false;
		}
		var volume = readVolume();
		var muted = readMuted();
		// 因浏览器自动播放策略临时静音（区别于用户主动静音），首次用户交互后自动解除
		var autoMuted = false;

		function effectiveMuted() {
			return muted || autoMuted;
		}

		function applyVolume() {
			video.volume = muted ? 0 : volume;
			// 静音状态靠 muted 属性保持（自动播放策略下也有效），非静音时解除 play 前设置的临时静音
			video.muted = effectiveMuted();
		}

		function notifyVolumeState() {
			window.dispatchEvent(new CustomEvent("bg-player-volume-state", { detail: { volume: volume, muted: effectiveMuted() } }));
		}

		var isPlaying = false;
		// 当前这次播放是否由"打开页面自动播放"发起（用户还没主动操控播放）
		var autoPlayActive = false;
		var currentIndex = 0;
		var errorCount = 0;
		var toastTimer = null;

		function showToast() {
			if (!toast) return;
			toast.classList.remove("opacity-0");
			toast.classList.add("opacity-100");
			if (toastTimer) clearTimeout(toastTimer);
			toastTimer = setTimeout(function () {
				toast.classList.remove("opacity-100");
				toast.classList.add("opacity-0");
			}, 3000);
		}

		function pickIndex(except) {
			if (urlList.length <= 1) return 0;
			if (playerMode === "random") {
				var n;
				do { n = Math.floor(Math.random() * urlList.length); } while (n === except);
				return n;
			}
			return (except + 1) % urlList.length;
		}

		function prevIndex() {
			if (urlList.length <= 1) return 0;
			if (playerMode === "random") return pickIndex(currentIndex);
			return (currentIndex - 1 + urlList.length) % urlList.length;
		}

		function syncAttr() {
			document.body.toggleAttribute("data-bg-video-playing", isPlaying);
			document.documentElement.toggleAttribute("data-bg-video-playing", isPlaying);
			// 自动播放（用户还没主动操控播放）时，视频只顶替静态壁纸图片，
			// 保留 homeText 文字层与遮罩，避免刚进首页标题就消失
			var keepOverlay = isPlaying && autoPlayActive;
			document.body.toggleAttribute("data-bg-video-autoplay", keepOverlay);
			document.documentElement.toggleAttribute("data-bg-video-autoplay", keepOverlay);
			window.dispatchEvent(new CustomEvent("bg-player-state-change", { detail: { playing: isPlaying } }));
		}

		function stopPlayback() {
			isPlaying = false;
			if (overlay) { overlay.classList.remove("opacity-100"); overlay.classList.add("opacity-0"); }
			syncAttr();
		}

		function doPlay(opts) {
			// opts.gestureUnlock：静音起播 + 挂"首次用户交互后开声"的解锁（自动播放场景）
			// 其他场景（用户点了播放按钮，已有交互）：静音起播，play 成功 100ms 后按用户设置恢复声音
			var gestureUnlock = !!(opts && opts.gestureUnlock);
			video.src = urlList[currentIndex];
			video.volume = muted ? 0 : volume;
			video.muted = true;
			var p = video.play();
			if (p && p.then) {
				p.then(function () {
					if (gestureUnlock) {
						autoMuted = true;
						notifyVolumeState();
						armGestureUnlock();
					} else {
						setTimeout(function () { if (video && isPlaying) applyVolume(); }, 100);
					}
				}).catch(function () {
					// 连静音起播都被拒绝（极少数环境）：按用户设置再试一次，仍失败则退回静态壁纸
					video.muted = effectiveMuted();
					var p2 = video.play();
					if (p2 && p2.catch) p2.catch(stopPlayback);
				});
			}
		}

		// 自动播放场景：静音起播后，等用户第一次交互（点击/按键/触摸/滚动）再开声
		var UNLOCK_EVENTS = ["pointerdown", "keydown", "touchstart", "wheel"];
		var unlockHandler = null;
		function armGestureUnlock() {
			if (unlockHandler || muted) return; // 用户本来就要静音，无需解锁
			unlockHandler = function () {
				for (var i = 0; i < UNLOCK_EVENTS.length; i++) window.removeEventListener(UNLOCK_EVENTS[i], unlockHandler);
				unlockHandler = null;
				autoMuted = false;
				if (isPlaying) applyVolume();
				notifyVolumeState();
			};
			for (var i = 0; i < UNLOCK_EVENTS.length; i++) {
				window.addEventListener(UNLOCK_EVENTS[i], unlockHandler, { passive: true });
			}
		}

		function shouldAutoPlay() {
			// 纯色背景模式下没有视频层，不自动播放
			if (document.documentElement.getAttribute("data-wallpaper-mode") === "none") return false;
			var isDesktop = true;
			if (window.matchMedia) isDesktop = window.matchMedia("(min-width: 768px)").matches;
			return isDesktop ? autoPlayDesktop : autoPlayMobile;
		}

		function tryAutoPlay() {
			if (isPlaying || !shouldAutoPlay()) return;
			currentIndex = playerMode === "random" ? pickIndex(-1) : 0;
			var started = false;
			var onPlaying = function () {
				if (started) return;
				started = true;
				video.removeEventListener("playing", onPlaying);
				// 首帧就绪后再切到视频层，避免壁纸图片先消失导致闪白
				isPlaying = true;
				autoPlayActive = true;
				if (overlay) { overlay.classList.remove("opacity-0"); overlay.classList.add("opacity-100"); }
				syncAttr();
			};
			video.addEventListener("playing", onPlaying);
			// 兜底：8 秒还没播起来就放弃，保持静态壁纸
			setTimeout(function () {
				if (started) return;
				started = true;
				video.removeEventListener("playing", onPlaying);
				try { video.pause(); } catch (e) {}
				stopPlayback();
			}, 8000);
			doPlay({ gestureUnlock: true });
		}

		function switchTrack(index) {
			if (index < 0 || index >= urlList.length) return;
			currentIndex = index;
			// 用户主动切轨，退出"自动播放"的宽容模式
			autoPlayActive = false;
			if (isPlaying) {
				doPlay();
			} else {
				video.src = urlList[currentIndex];
				video.load();
			}
		}

		function toggle() {
			// 用户主动点播放/暂停，退出"自动播放"的宽容模式（此时进入完整沉浸播放）
			autoPlayActive = false;
			isPlaying = !isPlaying;
			if (isPlaying) {
				if (currentIndex >= urlList.length) currentIndex = 0;
				syncAttr();
				if (overlay) { overlay.classList.remove("opacity-0"); overlay.classList.add("opacity-100"); }
				requestAnimationFrame(function () { doPlay(); });
			} else {
				video.pause();
				if (overlay) { overlay.classList.remove("opacity-100"); overlay.classList.add("opacity-0"); }
				syncAttr();
			}
		}

		function onEnded() {
			if (isMultiple) {
				currentIndex = pickIndex(currentIndex);
				doPlay();
			} else {
				isPlaying = false;
				if (overlay) { overlay.classList.remove("opacity-100"); overlay.classList.add("opacity-0"); }
				syncAttr();
			}
		}

		function onError() {
			errorCount++;
			if (isMultiple && errorCount < urlList.length) {
				// 多视频模式下自动尝试下一个
				currentIndex = pickIndex(currentIndex);
				video.src = urlList[currentIndex];
				video.load();
			} else {
				// 所有视频都失败或只有单个视频
				isPlaying = false;
				if (overlay) { overlay.classList.remove("opacity-100"); overlay.classList.add("opacity-0"); }
				syncAttr();
				showToast();
			}
		}

	// 监听导航栏播放按钮事件
	window.addEventListener("bg-player-toggle", toggle);
	// 监听导航栏音量面板的设置（拖动滑块 / 切换静音）
	window.addEventListener("bg-player-volume-set", function (e) {
		var d = (e && e.detail) || {};
		if (typeof d.volume === "number") volume = clampVolume(d.volume);
		if (typeof d.muted === "boolean") muted = d.muted;
		// 用户主动调节过音量/静音，视为已有交互意图，解除自动播放的临时静音
		autoMuted = false;
		applyVolume();
	});
		video.addEventListener("ended", onEnded);
		video.addEventListener("error", onError);
		// 播放成功时重置错误计数
		video.addEventListener("playing", function () { errorCount = 0; });
		if (prevBtn) prevBtn.addEventListener("click", function () { switchTrack(prevIndex()); });
		if (nextBtn) nextBtn.addEventListener("click", function () { switchTrack(pickIndex(currentIndex)); });

		// 切换壁纸模式时停止播放
		window.addEventListener("wallpaperModeChange", function (e) {
			if (e.detail && e.detail.mode === "none" && isPlaying) {
				isPlaying = false;
				video.pause();
				if (overlay) { overlay.classList.remove("opacity-100"); overlay.classList.add("opacity-0"); }
				syncAttr();
			}
		});

		// 动态控制 prev/next 按钮显示
		if (!isMultiple) {
			if (prevBtn) prevBtn.style.display = "none";
			if (nextBtn) nextBtn.style.display = "none";
		}

		// 应用已保存的音量设置，并把当前状态广播给导航栏音量面板
		applyVolume();
		notifyVolumeState();

		// 打开页面自动播放：等首屏渲染完再启动，避免和壁纸初始化抢资源
		if (shouldAutoPlay()) {
			var startAutoPlay = function () { setTimeout(tryAutoPlay, 200); };
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", startAutoPlay);
			} else {
				startAutoPlay();
			}
		}

		function cleanup() {
			// 视频仍在播放时保留属性，供 Navbar 同步按钮状态
			if (!isPlaying) {
				document.body.removeAttribute("data-bg-video-playing");
				document.documentElement.removeAttribute("data-bg-video-playing");
			}
		}
		document.addEventListener("astro:before-swap", cleanup);
	})();
</script>

<style>
	/* 用户主动播放：静态壁纸各层整体让位给视频（沉浸模式） */
	:global([data-bg-video-playing]:not([data-bg-video-autoplay]) #banner-images-container),
	:global([data-bg-video-playing]:not([data-bg-video-autoplay]) #banner-dim-container),
	:global([data-bg-video-playing]:not([data-bg-video-autoplay]) #banner-overlay-container),
	:global([data-bg-video-playing]:not([data-bg-video-autoplay]) #header-waves),
	:global([data-bg-video-playing]:not([data-bg-video-autoplay]) #wallpaper-gradient) {
		opacity: 0 !important;
		transition: opacity 0.5s ease;
	}

	/* 打开页面自动播放：只让静态壁纸图片让位，保留遮罩、首页文字与底部渐变 */
	:global([data-bg-video-autoplay] #banner-images-container) {
		opacity: 0 !important;
		transition: opacity 0.5s ease;
	}
</style>
