---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DisplaySettings from "@/components/controls/DisplaySettingsIntegrated.svelte";
import LightDarkSwitch from "@/components/controls/LightDarkSwitch.svelte";
import Search from "@/components/controls/Search.svelte";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import {
	backgroundWallpaper,
	displaySettingsConfig,
	siteConfig,
} from "@/config";
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { isHomePage } from "@/utils/layout-utils";
import { resolveNavMenuLinks } from "@/utils/nav-menu-utils";
import { url } from "@/utils/url-utils";
import DropdownMenu from "./DropdownMenu.astro";

const className = Astro.props.class;

// 检查是否为首页
const isHomePageCheck = isHomePage(Astro.url.pathname);

// 导航栏透明模式：banner 用 banner.navbar，fullscreen 用 fullscreen.navbar（semifull 仅首页动态）
const navbarTransparentMode =
	backgroundWallpaper.mode === "banner"
		? (() => {
				const t = backgroundWallpaper.banner?.navbar?.transparentMode || "semi";
				return t === "semifull" && !isHomePageCheck ? "semi" : t;
			})()
		: backgroundWallpaper.mode === "fullscreen"
			? (() => {
					const fs =
						backgroundWallpaper.fullscreen?.navbar?.transparentMode ||
						"semifull";
					return fs === "semifull" && isHomePageCheck ? "semifull" : "semi";
				})()
			: "semi";

// 获取导航栏模糊度（0 即关闭导航栏毛玻璃）
const navbarBlur =
	backgroundWallpaper.mode === "banner"
		? (backgroundWallpaper.banner?.navbar?.blur ?? 20)
		: 0;

// 背景视频音量：config 里的默认值（0-1），作为滑块初值与 localStorage 缺失时的回退
const bgPlayerEnabled =
	backgroundWallpaper.playerEnable && backgroundWallpaper.mode !== "none";
const bgVolumeDefault = Math.min(
	1,
	Math.max(0, backgroundWallpaper.common?.playerVolume ?? 0.1),
);
const bgVolumeDefaultPct = Math.round(bgVolumeDefault * 100);

// 获取导航栏标题，如果没有设置则使用 siteConfig.title
const navbarTitle = siteConfig.navbar.title || siteConfig.title;

// 获取导航栏宽度配置
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
const navbarMenuAlign = siteConfig.navbar.menuAlign ?? "center";
const isNavbarMenuCentered = navbarMenuAlign === "center";

// 检查是否有任何显示设置可用（总开关关闭时下方各项均为 false）
const isDisplaySettingsEnabled = displaySettingsConfig.enable;
const showThemeColor = displaySettingsConfig.themeColorSwitchable;
const isWallpaperSwitchable = displaySettingsConfig.wallpaperModeSwitchable;
const allowLayoutSwitch = displaySettingsConfig.layoutSwitchable;
const hasDisplaySettings =
	showThemeColor || isWallpaperSwitchable || allowLayoutSwitch;

// 解析导航栏链接（按 siteConfig.pages 过滤 + i18n 名称），桌面下拉与移动抽屉共用
const links: NavBarLink[] = resolveNavMenuLinks();

// 处理导航栏 Logo 图片，image / url 类型支持亮暗色分别设置
const logoConfig = siteConfig.navbar.logo;
const logoAlt = logoConfig?.alt || siteConfig.title;
const logoIsImage = logoConfig?.type === "image" || logoConfig?.type === "url";
const logoBaseClass = "navbar-logo h-7 w-7 mb-1 mr-2 object-contain";

const logoFiles = import.meta.glob<ImageMetadata>(
	"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
	{ import: "default" },
);

// 仅 src 目录下的本地图片交给 Astro 优化，public 目录和网络图片直接用原地址
async function resolveLocalLogo(value: string): Promise<ImageMetadata | null> {
	if (
		logoConfig?.type !== "image" ||
		!value ||
		value.startsWith("/") ||
		value.startsWith("http")
	) {
		return null;
	}
	const normalizedPath = path
		.normalize(path.join("../../", value))
		.replace(/\\/g, "/");
	const file = logoFiles[normalizedPath];
	return file ? await file() : null;
}

const logoLightValue = logoConfig?.value || "";
const logoDarkValue = logoConfig?.valueDark || "";
const hasDarkLogo = !!logoDarkValue && logoDarkValue !== logoLightValue;

const logoVariants = await Promise.all(
	(hasDarkLogo
		? [
				{ value: logoLightValue, theme: "light", themeClass: "dark:hidden" },
				{
					value: logoDarkValue,
					theme: "dark",
					themeClass: "hidden dark:block",
				},
			]
		: [{ value: logoLightValue, theme: "light", themeClass: "" }]
	)
		.filter((variant) => !!variant.value)
		.map(async (variant) => ({
			theme: variant.theme,
			class: variant.themeClass
				? `${logoBaseClass} ${variant.themeClass}`
				: logoBaseClass,
			image: await resolveLocalLogo(variant.value),
			src: logoConfig?.type === "url" ? variant.value : url(variant.value),
		})),
);
---
<div id="navbar" class="z-50" style={`--navbar-glass-blur: ${navbarBlur}px;`} data-transparent-mode={navbarTransparentMode} data-is-home={isHomePageCheck} data-full-width={navbarWidthFull}>
    <script is:inline define:vars={{
      bannerTMode: backgroundWallpaper.banner?.navbar?.transparentMode || "semi",
      bannerBlur: backgroundWallpaper.banner?.navbar?.blur ?? 20,
      fsTMode: backgroundWallpaper.fullscreen?.navbar?.transparentMode || "semifull",
      fsBlur: backgroundWallpaper.fullscreen?.navbar?.blur ?? 20,
    }}>
      // 首帧前按运行时壁纸模式修正导航栏透明模式：SSR 的 data-transparent-mode 按 config 设置，
      // 与运行时模式不一致时（如 config fullscreen + 存储 banner）会先按错误模式渲染闪烁，
      // 这里在解析期同步按 data-wallpaper-mode 修正（早于 rAF/DOMContentLoaded）
      (function () {
        const wm = document.documentElement.getAttribute("data-wallpaper-mode");
        const navbar = document.getElementById("navbar");
        if (!wm || !navbar) return;
        const isHome = navbar.getAttribute("data-is-home") === "true";
        let mode;
        let blur;
        if (wm === "fullscreen") {
          mode = fsTMode === "semifull" && isHome ? "semifull" : "semi";
          blur = fsBlur;
        } else if (wm === "banner") {
          mode = bannerTMode === "semifull" && !isHome ? "semi" : bannerTMode;
          blur = mode === "none" ? 0 : bannerBlur;
        } else {
          // overlay / none
          mode = "none";
          blur = 0;
        }
        navbar.setAttribute("data-transparent-mode", mode);
        navbar.style.setProperty("--navbar-glass-blur", `${blur}px`);
      })();
    </script>
    <div class:list={[
        className,
        "overflow-visible! h-18 px-4"
    ]}>
        <div class="mx-auto h-full w-full max-w-(--page-width) grid grid-cols-[auto_minmax(0,1fr)_auto] items-center">
            <a href={url('/')} class="btn-plain scale-animation rounded-lg h-13 px-3 md:px-5 font-bold active:scale-95">
                <div class:list={[
                    "flex flex-row items-center text-md",
                    siteConfig.navbar.followTheme ? "text-(--primary)" : "dark:text-white text-black"
                ]} style="font-family: var(--font-navbar-title, inherit)">
                                    {logoConfig?.type === "icon" ? (
                                        <Icon name={logoConfig.value || "material-symbols:home-pin-outline"} class="navbar-logo text-[1.75rem] mb-1 mr-2" />
                                    ) : logoIsImage && logoVariants.length > 0 ? (
                                        logoVariants.map((variant) => variant.image ? (
                                            <Picture
                                                src={variant.image}
                                                alt={logoAlt}
                                                class={variant.class}
                                                data-logo-theme={variant.theme}
                                                formats={getImageFormats()}
                                                fallbackFormat={getFallbackFormat()}
                                                widths={[28, 56]}
                                                loading="eager"
                                                fetchpriority="high"
                                            />
                                        ) : (
                                            <img src={variant.src} alt={logoAlt} class={variant.class} data-logo-theme={variant.theme} fetchpriority="high" />
                                        ))
                                    ) : (
                                        <Icon name="material-symbols:home-pin-outline" class="navbar-logo text-[1.75rem] mb-1 mr-2" />
                                    )}
                    {navbarTitle}
                </div>
            </a>
            <div class:list={[
                "hidden lg:flex items-center space-x-1 col-start-2",
                isNavbarMenuCentered
                    ? "justify-center"
                    : "justify-start pl-2"
            ]}>
                {links.map((l) => {
                    return <DropdownMenu link={l} />;
                })}
            </div>
            <div class="flex col-start-3 justify-self-end">
                <!--<SearchPanel client:load>-->
                <Search
                    client:load
                />
                {musicPlayerConfig.showInNavbar && (
                    <button aria-label={i18n(I18nKey.music)} aria-controls="music-nav-panel" aria-expanded="false" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="music-player-switch">
                        <Icon name="material-symbols:music-note-rounded" class="text-[1.25rem]"></Icon>
                    </button>
                )}
                {bgPlayerEnabled && (
                    <button
                        aria-label={i18n(I18nKey.videoPlay)}
						class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90 hidden md:flex"
                        id="bg-player-toggle"
                        data-i18n-play={i18n(I18nKey.videoPlay)}
                        data-i18n-pause={i18n(I18nKey.videoPause)}
                    >
                        <span class="bg-player-icon-play"><Icon name="material-symbols:play-arrow-rounded" class="text-[1.5rem]" /></span>
                        <span class="bg-player-icon-pause hidden"><Icon name="material-symbols:pause-rounded" class="text-[1.5rem]" /></span>
                    </button>
                )}
                {bgPlayerEnabled && (
                    <button
                        aria-label={i18n(I18nKey.videoVolume)}
                        aria-controls="bg-volume-panel"
                        aria-expanded="false"
                        class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90 hidden md:flex"
                        id="bg-volume-switch"
                        data-i18n-volume={i18n(I18nKey.videoVolume)}
                        data-i18n-unmute={i18n(I18nKey.videoUnmute)}
                    >
                        <span class="bg-volume-icon-on"><Icon name="material-symbols:volume-up-rounded" class="text-[1.25rem]" /></span>
                        <span class="bg-volume-icon-off hidden"><Icon name="material-symbols:volume-off-rounded" class="text-[1.25rem]" /></span>
                    </button>
                )}
                {hasDisplaySettings && (
                        <button aria-label="Display Settings" aria-controls="display-setting" aria-expanded="false" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                            <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                        </button>
                )}
                {/* @ts-ignore */}
                <LightDarkSwitch client:load></LightDarkSwitch>
                <button aria-label="Menu" aria-controls="nav-menu-panel" aria-expanded="false" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 lg:hidden!" id="nav-menu-switch">
                    <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
                </button>
            </div>
        </div>
        {musicPlayerConfig.showInNavbar && (
            <div id="music-nav-panel" class="float-panel float-panel-closed absolute transition-all right-16 p-2 pt-4.5 w-80 z-50" data-floating-panel data-floating-panel-trigger="music-player-switch" inert aria-hidden="true">
                <MusicPlayer />
            </div>
        )}
        {bgPlayerEnabled && (
            <div id="bg-volume-panel" class="float-panel float-panel-closed absolute transition-all right-16 p-4 w-64 z-50" data-floating-panel data-floating-panel-trigger="bg-volume-switch" inert aria-hidden="true">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-medium text-(--btn-content)">{i18n(I18nKey.videoVolume)}</span>
                    <span id="bg-volume-value" class="text-xs font-bold text-(--btn-content) opacity-70">{bgVolumeDefaultPct}%</span>
                </div>
                <div class="flex items-center gap-3">
                    <button
                        type="button"
                        id="bg-volume-mute"
                        class="btn-plain scale-animation rounded-lg h-8 w-8 shrink-0 active:scale-90"
                        aria-label={i18n(I18nKey.videoMute)}
                        data-i18n-mute={i18n(I18nKey.videoMute)}
                        data-i18n-unmute={i18n(I18nKey.videoUnmute)}
                    >
                        <span class="bg-volume-mute-icon-on"><Icon name="material-symbols:volume-up-rounded" class="text-[1.125rem]" /></span>
                        <span class="bg-volume-mute-icon-off hidden"><Icon name="material-symbols:volume-off-rounded" class="text-[1.125rem]" /></span>
                    </button>
                    <input
                        id="bg-volume-slider"
                        type="range"
                        min="0"
                        max="100"
                        step="1"
                        value={String(bgVolumeDefaultPct)}
                        data-default-volume={String(bgVolumeDefault)}
                        aria-label={i18n(I18nKey.videoVolume)}
                        class="slider w-full overlay-slider"
                    />
                </div>
            </div>
        )}
        {isDisplaySettingsEnabled && <DisplaySettings client:load></DisplaySettings>}
    </div>
</div>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let musicBtn = document.getElementById("music-player-switch");
    if (musicBtn) {
        musicBtn.onclick = function () {
            let musicPanel = document.getElementById("music-nav-panel");
            if (musicPanel) {
                musicPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    // 背景视频播放器控制按钮
    let bgPlayerBtn = document.getElementById("bg-player-toggle");
    if (bgPlayerBtn) {
        bgPlayerBtn.onclick = function () {
            window.dispatchEvent(new CustomEvent("bg-player-toggle"));
        };
        function toggleBgPlayerIcon(playing: boolean) {
            var playIcon = bgPlayerBtn!.querySelector(".bg-player-icon-play");
            var pauseIcon = bgPlayerBtn!.querySelector(".bg-player-icon-pause");
            if (playIcon && pauseIcon) {
                playIcon.classList.toggle("hidden", playing);
                pauseIcon.classList.toggle("hidden", !playing);
            }
            var i18nPlay = bgPlayerBtn!.getAttribute("data-i18n-play") ?? "";
            var i18nPause = bgPlayerBtn!.getAttribute("data-i18n-pause") ?? "";
            var label = playing ? i18nPause : i18nPlay;
            bgPlayerBtn!.setAttribute("title", label);
            bgPlayerBtn!.setAttribute("aria-label", label);
        }
        window.addEventListener("bg-player-state-change", function (e) {
            var ce = e as CustomEvent;
            var playing = ce.detail && ce.detail.playing;
            toggleBgPlayerIcon(playing);
        });
        // 切换壁纸模式时隐藏/显示播放按钮
        window.addEventListener("wallpaperModeChange", function (e) {
            var ce = e as CustomEvent;
            var mode = ce.detail && ce.detail.mode;
            bgPlayerBtn!.style.display = mode === "none" ? "none" : "";
        });
        // Swup 导航时同步播放按钮状态（BackgroundPlayer 可能被重建，也可能持久存在）
        function syncBgPlayerBtn() {
            var playing = document.documentElement.hasAttribute("data-bg-video-playing");
            toggleBgPlayerIcon(playing);
        }
        if (window.swup && window.swup.hooks) {
            window.swup.hooks.on("content:replace", syncBgPlayerBtn);
        } else {
            document.addEventListener("swup:enable", function () {
                window.swup.hooks.on("content:replace", syncBgPlayerBtn);
            });
        }
    }

    // 背景视频音量面板（滑块 + 静音切换，状态记忆在 localStorage）
    let bgVolumePanel = document.getElementById("bg-volume-panel");
    let bgVolumeBtn = document.getElementById("bg-volume-switch");
    let bgVolumeSliderEl = document.getElementById("bg-volume-slider") as HTMLInputElement | null;
    let bgVolumeValueLabel = document.getElementById("bg-volume-value");
    let bgVolumeMuteBtn = document.getElementById("bg-volume-mute");
    if (bgVolumePanel && bgVolumeBtn && bgVolumeSliderEl) {
        const VOLUME_KEY = "bgPlayerVolume";
        const MUTED_KEY = "bgPlayerMuted";
        const fallbackVolume = Number(bgVolumeSliderEl.getAttribute("data-default-volume") || "0.1");
        const slider = bgVolumeSliderEl;
        const btn = bgVolumeBtn;
        const panel = bgVolumePanel;

        function bgClamp(v: number) { return Math.min(1, Math.max(0, v)); }
        function bgReadVolume(): number {
            try {
                const s = localStorage.getItem(VOLUME_KEY);
                if (s !== null && s !== "") return bgClamp(Number(s));
            } catch (e) {}
            return bgClamp(fallbackVolume);
        }
        function bgReadMuted(): boolean {
            try { return localStorage.getItem(MUTED_KEY) === "1"; } catch (e) { return false; }
        }
        function bgPersist() {
            try {
                localStorage.setItem(VOLUME_KEY, String(bgVolume));
                localStorage.setItem(MUTED_KEY, bgMuted ? "1" : "0");
            } catch (e) {}
        }
        function bgUpdateRangeProgress(input: HTMLInputElement) {
            const min = Number(input.min || 0);
            const max = Number(input.max || 100);
            const value = Number(input.value || 0);
            const progress = ((value - min) * 100) / (max - min || 1);
            input.style.setProperty("--range-progress", progress + "%");
        }
        function bgSyncUI() {
            const pct = Math.round(bgVolume * 100);
            slider.value = String(pct);
            bgUpdateRangeProgress(slider);
            if (bgVolumeValueLabel) bgVolumeValueLabel.textContent = pct + "%";

            const onIcon = btn.querySelector(".bg-volume-icon-on");
            const offIcon = btn.querySelector(".bg-volume-icon-off");
            if (onIcon && offIcon) {
                onIcon.classList.toggle("hidden", bgMuted);
                offIcon.classList.toggle("hidden", !bgMuted);
            }

            const tVolume = btn.getAttribute("data-i18n-volume") ?? "";
            const tUnmute = btn.getAttribute("data-i18n-unmute") ?? "";
            btn.setAttribute("title", bgMuted ? tUnmute : tVolume);
            btn.setAttribute("aria-label", bgMuted ? tUnmute : tVolume);

            if (bgVolumeMuteBtn) {
                const tMute = bgVolumeMuteBtn.getAttribute("data-i18n-mute") ?? "";
                bgVolumeMuteBtn.setAttribute("title", bgMuted ? tUnmute : tMute);
                bgVolumeMuteBtn.setAttribute("aria-label", bgMuted ? tUnmute : tMute);
                const mOn = bgVolumeMuteBtn.querySelector(".bg-volume-mute-icon-on");
                const mOff = bgVolumeMuteBtn.querySelector(".bg-volume-mute-icon-off");
                if (mOn && mOff) {
                    mOn.classList.toggle("hidden", bgMuted);
                    mOff.classList.toggle("hidden", !bgMuted);
                }
            }
        }
        function bgEmit() {
            window.dispatchEvent(new CustomEvent("bg-player-volume-set", { detail: { volume: bgVolume, muted: bgMuted } }));
        }

        let bgVolume = bgReadVolume();
        let bgMuted = bgReadMuted();
        bgSyncUI();
        // 首次访问时把 config 里的默认音量同步给播放器（播放器自己也会读 localStorage）
        bgEmit();

        btn.onclick = function () {
            panel.classList.toggle("float-panel-closed");
            btn.setAttribute("aria-expanded", panel.classList.contains("float-panel-closed") ? "false" : "true");
        };

        slider.oninput = function () {
            bgVolume = bgClamp(Number(slider.value) / 100);
            // 拖动滑块视为要出声，自动解除静音
            if (bgMuted && bgVolume > 0) bgMuted = false;
            bgSyncUI();
            bgEmit();
            bgPersist();
        };

        if (bgVolumeMuteBtn) {
            bgVolumeMuteBtn.onclick = function () {
                bgMuted = !bgMuted;
                bgSyncUI();
                bgEmit();
                bgPersist();
            };
        }

        // 播放器侧广播状态时同步 UI（例如播放器重建后上报自身音量）
        window.addEventListener("bg-player-volume-state", function (e) {
            const ce = e as CustomEvent;
            const d = ce.detail || {};
            if (typeof d.volume === "number") bgVolume = bgClamp(d.volume);
            if (typeof d.muted === "boolean") bgMuted = d.muted;
            bgSyncUI();
        });

        // 切换壁纸模式时隐藏/显示音量按钮
        window.addEventListener("wallpaperModeChange", function (e) {
            const ce = e as CustomEvent;
            const mode = ce.detail && ce.detail.mode;
            btn.style.display = mode === "none" ? "none" : "";
        });
    }

    let themeSwitchBtn = document.getElementById("scheme-switch");
    if (themeSwitchBtn) {
        themeSwitchBtn.onclick = function () {
            let themePanel = document.getElementById("theme-mode-panel");
            if (themePanel) {
                themePanel.classList.toggle("float-panel-closed");
            }
        };
    }

    document.addEventListener("click", function(event) {
        // nav-menu-panel 不再走点击外部关闭：面板现在覆盖全屏（inset-0），任意点击都在面板内，
        // 该监听永不触发；关闭由抽屉自己的遮罩点击/Document 委托负责。
        const panels = ["display-setting", "music-nav-panel", "theme-mode-panel", "bg-volume-panel"];
        const buttons = ["display-settings-switch", "music-player-switch", "scheme-switch", "bg-volume-switch"];

        panels.forEach((id, index) => {
            const panel = document.getElementById(id);
            const button = document.getElementById(buttons[index]);
            if (panel && button && !panel.classList.contains("float-panel-closed")) {
                if (event.target instanceof Node && !panel.contains(event.target) && !button.contains(event.target)) {
                    panel.classList.add("float-panel-closed");
                }
            }
        });
    });
}

loadButtonScript();

// 为semifull模式添加滚动检测逻辑
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const transparentMode = navbar.getAttribute('data-transparent-mode');
    if (transparentMode !== 'semifull') return;

    // 无论首页/非首页，semifull 都由滚动位置决定是否进入 scrolled 状态
    // 先移除之前的滚动监听器，避免重复绑定
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
        window.semifullScrollHandler = undefined;
    }

    // 初始状态不强制加 scrolled，保持透明；滚动后再切换
    navbar.classList.remove('scrolled');

    let ticking = false;

    function updateNavbarState() {
        if (document.documentElement.classList.contains('is-page-transitioning')) {
            // 全屏壁纸模式：切换期间保持当前 scrolled 状态，避免点击瞬间导航栏背景突然消失
            // （否则导航栏会闪一下透明、切完又恢复成卡片底色）；其他模式沿用旧的强制透明逻辑
            if (
                document.documentElement.getAttribute('data-wallpaper-mode') !==
                'fullscreen'
            ) {
                navbar!.classList.remove('scrolled');
            }
            ticking = false;
            return;
        }

        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const threshold = 50; // 滚动阈值，可以根据需要调整
        // 使用批量DOM操作优化性能
        if (scrollTop > threshold) {
            navbar!.classList.add('scrolled');
        } else {
            navbar!.classList.remove('scrolled');
        }

        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }

    // 移除之前的滚动事件监听器（如果存在）
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler as () => void);
    }

    // 保存新的事件处理器引用
    window.semifullScrollHandler = requestTick as unknown as (() => void);

    // 监听滚动事件
    window.addEventListener('scroll', requestTick, { passive: true });

    // 初始化状态
    updateNavbarState();
}

// 将函数暴露到全局对象，供页面切换时调用
window.initSemifullScrollDetection = initSemifullScrollDetection;

// 页面加载完成后初始化滚动检测
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

